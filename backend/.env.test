# Test environment configuration
NODE_ENV=test

# JWT_SECRET must be at least 32 characters (security requirement from auth.middleware.js)
JWT_SECRET=test-secret-key-must-be-at-least-32-characters-long-for-security-testing
JWT_EXPIRE=1h

# Database - not used since we mock everything
MONGODB_URI=mongodb://localhost:27017/shuttle-test

# Ably - not used in tests
ABLY_API_KEY=test-key
