# Backend Environment Variables
# Copy this file to .env and fill in the values.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
# Local MongoDB or MongoDB Atlas connection string.
MONGODB_URI=

# Application JWT signing. Generate a random value of at least 32 characters.
JWT_SECRET=
JWT_EXPIRE=15m

# Clerk server credentials. Never put these in the frontend environment.
# https://dashboard.clerk.com/ > Your App > API Keys
CLERK_SECRET_KEY=
# Required only when receiving Clerk webhook events.
CLERK_WEBHOOK_SECRET=

# Ably server credential. Never expose this as NEXT_PUBLIC_*.
# https://ably.com/account/keys
ABLY_API_KEY=

# Web Push VAPID credentials.
# Generate with: npx web-push generate-vapid-keys
# https://developer.mozilla.org/en-US/docs/Web/API/Push_API
VAPID_EMAIL=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional authentication logging.
LOG_AUTH_SUCCESS=false
