{
  "name": "shuttle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first -n api,worker \"nodemon src/server.js\" \"nodemon src/workers/eta-worker.js\"",
    "dev:api": "node src/server.js",
    "build": "echo \"skip\"",
    "start": "concurrently -k -s first -n api,worker \"node src/server.js\" \"node src/workers/eta-worker.js\"",
    "seed:routes": "node src/scripts/seed-routes.js",
    "seed:driver": "node src/scripts/seed-test-driver.js",
    "test:db": "node src/scripts/test-connection.js",
    "test": "mocha --require tests/setup.js 'tests/**/*.test.js' --timeout 10000",
    "test:unit": "mocha --require tests/setup.js 'tests/unit/**/*.test.js' --timeout 10000",
    "test:integration": "mocha --require tests/setup.js 'tests/integration/**/*.test.js' --timeout 10000",
    "test:watch": "mocha --require tests/setup.js 'tests/**/*.test.js' --timeout 10000 --watch",
    "security:audit": "npm audit && snyk test",
    "security:fix": "npm audit fix && npm audit fix --force",
    "create-admin": "node src/scripts/createAdmin.js"
  },
  "dependencies": {
    "@clerk/backend": "^2.18.3",
    "@clerk/nextjs": "^6.33.0",
    "ably": "^2.14.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "next": "^15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "svix": "^1.77.0",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.21",
    "c8": "^10.1.2",
    "chai": "^5.1.1",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "mocha": "^12.0.0",
    "nodemon": "^3.1.10",
    "sinon": "^22.1.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6"
  }
}
