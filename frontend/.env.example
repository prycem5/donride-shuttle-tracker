# =============================================================================
# Frontend Environment Variables
# =============================================================================
# Copy this to .env.local and fill in your values
# IMPORTANT: In Next.js, file must be named .env.local (not .env)

# =============================================================================
# Clerk Authentication
# =============================================================================
# Public browser key. Get from: https://dashboard.clerk.com/ > Your App > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# =============================================================================
# Backend API URL
# =============================================================================
# Used by driver, student, tracking, and realtime requests.
# Local backend default: http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
# Navbar currently reads this name for the user lookup request.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# =============================================================================
# Google Maps API
# =============================================================================
# Browser key. Restrict it by HTTP referrer and enabled APIs.
# Get from: https://console.cloud.google.com/apis/credentials
# Enable Maps JavaScript API, Routes API, and Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Google Maps map ID used by the legacy MapView component.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Optional map defaults; code has PFW coordinates and zoom fallbacks.
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=41.1181
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=-85.1093
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=14

# =============================================================================
# Ably Real-time
# =============================================================================
# No Ably API key belongs in the frontend. The frontend requests a short-lived
# token from the backend using the Clerk session. Keep ABLY_API_KEY in the
# backend environment only.
